# =================================================================
# SWARIVA AI — Environment Variables Template
# =================================================================
# Copy this file to .env and configure your credentials.
# NEVER commit .env to GitHub or publicly expose API keys!

# ── Gnani AI API Credentials ──
# Single master key (backward compatible default)
GNANI_API_KEY=your_gnani_api_key_here

# Granular service keys (Optional — created via https://app.gnani.ai/)
# Defaults to GNANI_API_KEY if left blank
GNANI_PRISMA_API_KEY=
GNANI_TIMBRE_API_KEY=
GNANI_EVON_API_KEY=

# ── Gnani Evon v3.3 Reasoning Model (30B-A3B) ──
# Set to remote cloud endpoint (e.g., vLLM / llama.cpp / Colab tunnel or Gnani hosted endpoint)
EVON_BASE_URL=http://localhost:30000/v1
EVON_MODEL=gnani/gnani-evon-v3.3-30B-A3B
EVON_TIMEOUT_SECONDS=30.0
ENABLE_EVON=false

# ── High-Speed Cloud LLM Reasoning (Tier 2 / Groq Free Tier) ──
# Free API key obtainable from: https://console.groq.com/keys
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# ── Supabase Cloud PostgreSQL & Auth (Phase 5) ──
# If omitted or left as placeholder, SWARIVA runs on local SQLite fallback
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ── Application Settings ──
APP_ENV=development
APP_PORT=8000
