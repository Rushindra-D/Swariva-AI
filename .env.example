# =================================================================
# SWARIVA AI — Environment Variables Template
# =================================================================
# Copy this file to .env and configure your credentials.
# NEVER commit .env to GitHub or publicly expose API keys!

# ── Gnani AI API Credentials ──
# Single master key (backward compatible default)
GNANI_API_KEY=your_gnani_api_key_here

# Granular service keys (created via https://app.gnani.ai/)
# Defaults to GNANI_API_KEY if left blank
GNANI_PRISMA_API_KEY=
GNANI_TIMBRE_API_KEY=

# ── Google Gemini Reasoning & Answer Generation (Primary Engine) ──
# Obtain your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_new_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0

# ── Supabase Cloud PostgreSQL & Auth (Phase 5) ──
# If omitted or left as placeholder, SWARIVA runs on local SQLite fallback
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ── Application Settings ──
APP_ENV=development
APP_PORT=8000
